"""Environment template for the merged QueryNest AI / CompliAssist repo."""

# Frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend / Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# AI providers
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
VOYAGE_API_KEY=your_voyage_key
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.0-flash

# Security and infrastructure
WIDGET_JWT_SECRET=your_widget_jwt_secret
WIDGET_TOKEN_EXPIRE_MINUTES=60
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Runtime
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CompliAssist settings
PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LLM_MODEL=mistral:latest
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_FILE=data/vector_index/faiss_index
EMBEDDING_DIMENSION=384
FAISS_METRIC=L2
TOP_K_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.4
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_LENGTH=50
AUDIT_DB_PATH=logs/audit_log.db
AUDIT_RETENTION_DAYS=2555
AUDIT_BATCH_SIZE=100
RESTRICTED_ENTITIES_CSV=Data1/Data/Restricted_Entities_Registry.csv
APPROVED_ALTERNATIVES_CSV=Data1/Data/Approved_Alternatives_Registry.csv
DATA_SOURCE_DIR=Data1
GRAPH_DB_PATH=data/knowledge_graph.db
GRAPH_MAX_SOURCE_CHARS=2000
GRAPH_REBUILD_CHUNK_LIMIT=0
CORS_ORIGINS=*
